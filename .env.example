# Environment Variables for DS Scheduler
# Copy this to .env.local and fill in your values

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ds-scheduler

# JWT secret for auth tokens — use a long random string
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin account credentials (seeded on first run)
ADMIN_EMAIL=admin@dhakasessions.com
ADMIN_PASSWORD=admin123

# Next.js
NEXTAUTH_URL=http://localhost:3000
